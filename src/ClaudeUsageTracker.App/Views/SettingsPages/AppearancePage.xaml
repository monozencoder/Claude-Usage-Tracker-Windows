<UserControl x:Class="ClaudeUsageTracker.App.Views.SettingsPages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClaudeUsageTracker.App.Localization"
             xmlns:vm="clr-namespace:ClaudeUsageTracker.App.ViewModels"
             xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views">
    <!-- The Appearance page of the settings window: theme, language and what the flyout looks like. -->
    <StackPanel>
        <TextBlock Text="{loc:Tr Settings_Appearance}" Style="{StaticResource SectionHeaderStyle}" />
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <views:SettingRow Title="{loc:Tr Settings_Theme}" Description="{loc:Tr Settings_ThemeDescription}">
                    <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                              ItemsSource="{x:Static vm:SettingsViewModel.ThemeOptions}" SelectedValue="{Binding Theme}" />
                </views:SettingRow>
                <Border Style="{StaticResource CardDividerStyle}" />
                <views:SettingRow Title="{loc:Tr Settings_Language}" Description="{loc:Tr Settings_LanguageDescription}">
                    <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                              ItemsSource="{x:Static vm:SettingsViewModel.LanguageOptions}" SelectedValue="{Binding Language}" />
                </views:SettingRow>
                <Border Style="{StaticResource CardDividerStyle}" />
                <views:SettingRow Title="{loc:Tr Settings_ResetTime}" Description="{loc:Tr Settings_ResetTimeDescription}">
                    <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                              ItemsSource="{x:Static vm:SettingsViewModel.ResetTimeDisplayOptions}" SelectedValue="{Binding ResetTimeDisplay}" />
                </views:SettingRow>
                <Border Style="{StaticResource CardDividerStyle}" />
                <views:SettingRow Title="{loc:Tr Settings_VisibleRows}" Description="{loc:Tr Settings_VisibleRowsDescription}">
                    <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                              ItemsSource="{x:Static vm:SettingsViewModel.VisibleRowsOptions}" SelectedValue="{Binding VisibleRows}" />
                </views:SettingRow>
                <Border Style="{StaticResource CardDividerStyle}" />
                <views:SettingRow Title="{loc:Tr Settings_TrayIcon}" Description="{loc:Tr Settings_TrayIconDescription}">
                    <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                              ItemsSource="{x:Static vm:SettingsViewModel.TrayIconStyleOptions}" SelectedValue="{Binding TrayIconStyle}" />
                </views:SettingRow>
                <Border Style="{StaticResource CardDividerStyle}" />
                <views:SettingRow Title="{loc:Tr Settings_MascotAnimation}" Description="{loc:Tr Settings_MascotAnimationDescription}" IsEnabled="{Binding CanAnimateMascot}">
                    <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                              ItemsSource="{x:Static vm:SettingsViewModel.MascotAnimationOptions}" SelectedValue="{Binding MascotAnimation}" />
                </views:SettingRow>
            </StackPanel>
        </Border>
        <TextBlock Text="{loc:Tr Settings_SectionWindow}" Style="{StaticResource GroupHeaderStyle}" />
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <views:SettingRow Title="{loc:Tr Settings_Opacity}" Description="{loc:Tr Settings_OpacityDescription}">
                    <!-- Applied as it's dragged, so an open flyout previews the value. The button
                         puts it back to 100% in one click; disabled while already there. -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding ResetFlyoutOpacityCommand}" ToolTip="{loc:Tr Settings_ResetTo100}"
                                AutomationProperties.Name="{loc:Tr Settings_ResetTo100}">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" />
                        </Button>
                        <TextBlock Text="{Binding FlyoutOpacityPercent, StringFormat={}{0}%}" Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Width="36" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider Style="{StaticResource SliderStyle}" Width="150" VerticalAlignment="Center"
                                Minimum="{Binding MinFlyoutOpacityPercent, Mode=OneTime}"
                                Maximum="{Binding MaxFlyoutOpacityPercent, Mode=OneTime}"
                                Value="{Binding FlyoutOpacityPercent}"
                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                IsMoveToPointEnabled="True"
                                AutomationProperties.Name="{loc:Tr Settings_Opacity}" />
                    </StackPanel>
                </views:SettingRow>
                <Border Style="{StaticResource CardDividerStyle}" />
                <views:SettingRow Title="{loc:Tr Settings_Scale}" Description="{loc:Tr Settings_ScaleDescription}">
                    <!-- Same scale as dragging the flyout's edges; applied as it's dragged, like the opacity. -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                Command="{Binding ResetFlyoutScaleCommand}" ToolTip="{loc:Tr Settings_ResetTo100}"
                                AutomationProperties.Name="{loc:Tr Settings_ResetTo100}">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" />
                        </Button>
                        <TextBlock Text="{Binding FlyoutScalePercent, StringFormat={}{0}%}" Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Width="36" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider Style="{StaticResource SliderStyle}" Width="150" VerticalAlignment="Center"
                                Minimum="{Binding MinFlyoutScalePercent, Mode=OneTime}"
                                Maximum="{Binding MaxFlyoutScalePercent, Mode=OneTime}"
                                Value="{Binding FlyoutScalePercent}"
                                TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                IsMoveToPointEnabled="True"
                                AutomationProperties.Name="{loc:Tr Settings_Scale}" />
                    </StackPanel>
                </views:SettingRow>
                <Border Style="{StaticResource CardDividerStyle}" />
                <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding FlyoutCompact}"
                          views:SettingRow.Title="{loc:Tr Settings_FlyoutCompact}" views:SettingRow.Description="{loc:Tr Settings_FlyoutCompactDescription}" />
                <Border Style="{StaticResource CardDividerStyle}" />
                <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding FlyoutShowMascot}"
                          views:SettingRow.Title="{loc:Tr Settings_FlyoutMascot}" views:SettingRow.Description="{loc:Tr Settings_FlyoutMascotDescription}" />
            </StackPanel>
        </Border>
        <!-- What each one-line row is made of, in the two places that have them. -->
        <TextBlock Text="{loc:Tr Settings_SectionCompact}" Style="{StaticResource GroupHeaderStyle}" />
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding CompactShowLabels}"
                          views:SettingRow.Title="{loc:Tr Settings_CompactLabels}" views:SettingRow.Description="{loc:Tr Settings_CompactLabelsDescription}" />
                <Border Style="{StaticResource CardDividerStyle}" />
                <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding CompactShowPercentage}"
                          views:SettingRow.Title="{loc:Tr Settings_CompactPercentage}" views:SettingRow.Description="{loc:Tr Settings_CompactPercentageDescription}" />
                <Border Style="{StaticResource CardDividerStyle}" />
                <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding CompactShowResetTime}"
                          views:SettingRow.Title="{loc:Tr Settings_CompactResetTime}" views:SettingRow.Description="{loc:Tr Settings_CompactResetTimeDescription}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
