<UserControl x:Class="ClaudeUsageTracker.App.Views.UsageRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,12">
        <DockPanel LastChildFill="False">
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource BodyTextStyle}" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding PercentageText}" Foreground="{DynamicResource TextPrimaryBrush}"
                       Style="{StaticResource BodyStrongTextStyle}" DockPanel.Dock="Right" />
        </DockPanel>
        <!-- Bar colors come from the palette (Obsidian's green / orange / red), so they follow the theme live. -->
        <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,6,0,4"
                     Background="{DynamicResource ProgressTrackBrush}">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource PillProgressBarStyle}">
                    <Setter Property="Foreground" Value="{DynamicResource UsageSafeBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Moderate">
                            <Setter Property="Foreground" Value="{DynamicResource UsageModerateBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Critical">
                            <Setter Property="Foreground" Value="{DynamicResource UsageCriticalBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <TextBlock Text="{Binding ResetText}" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource CaptionTextStyle}" />
    </StackPanel>
</UserControl>
