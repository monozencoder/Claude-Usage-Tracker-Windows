<UserControl x:Class="ClaudeUsageTracker.App.Views.UsageRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,10">
        <DockPanel LastChildFill="False">
            <TextBlock Text="{Binding Label}" Foreground="#FFEFEFEF" FontSize="12" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding PercentageText}" Foreground="White" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right" />
        </DockPanel>
        <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,2"
                     Background="#22FFFFFF" BorderThickness="0"
                     Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
        <TextBlock Text="{Binding ResetText}" Foreground="#88FFFFFF" FontSize="10" />
    </StackPanel>
</UserControl>
