<Window x:Class="ClaudeUsageTracker.App.Views.TaskbarBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextOptions.TextFormattingMode="Display"
        Title="Claude Usage Tracker"
        SizeToContent="Width" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000">
    <!-- A strip laid over the taskbar, left of the notification area: one compact line per usage
         row (label, bar, percentage). As tall as the taskbar and as wide as its content; placed by
         TaskbarBarController, and off screen until it has been. The text/track/backdrop/hover brushes
         are set in code-behind to suit the taskbar's color, which follows Windows' mode, not the app
         theme (or, over a full-screen app, to stand on their own). -->
    <Border CornerRadius="4" Margin="0,4" Padding="8,0" Cursor="Hand" MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseLeftButtonUp" LostMouseCapture="OnLostMouseCapture">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TaskbarBarBackdropBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TaskbarBarHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Center" Focusable="False" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.8" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TaskbarBarTextBrush}" />
                        <ProgressBar Grid.Column="1" Value="{Binding Percentage, Mode=OneWay}" Minimum="0" Maximum="100"
                                     Height="4" Margin="6,1,6,0" VerticalAlignment="Center"
                                     Background="{DynamicResource TaskbarBarTrackBrush}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource PillProgressBarStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource UsageSafeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Moderate">
                                            <Setter Property="Foreground" Value="{DynamicResource UsageModerateBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Critical">
                                            <Setter Property="Foreground" Value="{DynamicResource UsageCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Column="2" Text="{Binding PercentageText}" FontSize="11" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TaskbarBarTextBrush}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
