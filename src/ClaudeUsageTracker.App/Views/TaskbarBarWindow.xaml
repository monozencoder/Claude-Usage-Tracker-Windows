<Window x:Class="ClaudeUsageTracker.App.Views.TaskbarBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        TextOptions.TextFormattingMode="Display"
        Title="Claude Usage Tracker"
        SizeToContent="Width" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000">
    <!-- A strip laid over the taskbar, left of the notification area: one compact line per usage
         row (label, bar, percentage, time left), of which the user picks the rows and the parts.
         As tall as the taskbar and as wide as its content; placed by TaskbarBarController, and off
         screen until it has been. The text/track/backdrop/hover brushes are set in code-behind to
         suit the taskbar's color, which follows Windows' mode, not the app theme (or, over a
         full-screen app, to stand on their own). -->
    <Border CornerRadius="4" Margin="0,4" Padding="8,0" Cursor="Hand" MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseLeftButtonUp" LostMouseCapture="OnLostMouseCapture">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TaskbarBarBackdropBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TaskbarBarHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- Every row in full, whatever the strip itself shows: what each bar is, and when it resets. -->
        <Border.ToolTip>
            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                              ItemTemplate="{StaticResource UsageRowSummaryTemplate}" />
            </ToolTip>
        </Border.ToolTip>
        <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Center" Focusable="False" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.Style>
                            <!-- The row the user left out (RowsMode shows only the other one). -->
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RowsMode, RelativeSource={RelativeSource AncestorType=views:TaskbarBarWindow}}" Value="SessionOnly" />
                                            <Condition Binding="{Binding Kind}" Value="Weekly" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RowsMode, RelativeSource={RelativeSource AncestorType=views:TaskbarBarWindow}}" Value="WeeklyOnly" />
                                            <Condition Binding="{Binding Kind}" Value="Session" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ResetLead" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ResetTail" />
                        </Grid.ColumnDefinitions>
                        <!-- The row's name as LabelMode has it: short, in full, or left out (the tooltip always has it in full). -->
                        <TextBlock FontSize="11" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TaskbarBarTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="{Binding ShortLabel}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LabelMode, RelativeSource={RelativeSource AncestorType=views:TaskbarBarWindow}}" Value="Full">
                                            <Setter Property="Text" Value="{Binding Label}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LabelMode, RelativeSource={RelativeSource AncestorType=views:TaskbarBarWindow}}" Value="None">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Grid.Column="1" Value="{Binding Percentage, Mode=OneWay}" Minimum="0" Maximum="100"
                                     Height="4" Margin="0,1,6,0" VerticalAlignment="Center"
                                     Background="{DynamicResource TaskbarBarTrackBrush}"
                                     Style="{StaticResource UsageProgressBarStyle}" />
                        <TextBlock Grid.Column="2" Text="{Binding PercentageText}" FontSize="11" TextAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TaskbarBarTextBrush}" />
                        <!-- Time left until this row resets, in two columns ("4d" "10h" over "4h" "2m")
                             so the units line up between the rows. -->
                        <TextBlock Grid.Column="3" Text="{Binding ShortResetLead}" FontSize="11" Opacity="0.8" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TaskbarBarTextBrush}"
                                   Visibility="{Binding ShowResetTime, RelativeSource={RelativeSource AncestorType=views:TaskbarBarWindow}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="4" Text="{Binding ShortResetTail}" FontSize="11" Opacity="0.8" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="3,0,0,0" Foreground="{DynamicResource TaskbarBarTextBrush}"
                                   Visibility="{Binding ShowResetTime, RelativeSource={RelativeSource AncestorType=views:TaskbarBarWindow}, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
