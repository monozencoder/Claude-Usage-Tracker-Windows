<Window x:Class="ClaudeUsageTracker.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        xmlns:loc="clr-namespace:ClaudeUsageTracker.App.Localization"
        TextOptions.TextFormattingMode="Display"
        FontSize="{StaticResource BodyFontSize}"
        Title="Claude Usage Tracker"
        Width="348" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <!-- The margin is transparent room for FlyoutShadowEffect (blur 24, offset 4 down) and the
         slide-in animation; without it the shadow is clipped to the window's square bounds and
         shows as a faint rectangle behind the rounded corners. Width = 300 card + 2 x 24. -->
    <!-- The whole panel is a drag handle (buttons excluded), so the header can stay minimal. -->
    <Grid>
    <Border x:Name="RootPanel" Margin="24,24,24,28" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,8,16,16"
            Effect="{StaticResource FlyoutShadowEffect}" RenderTransformOrigin="0.5,0"
            MouseLeftButtonDown="OnPanelMouseLeftButtonDown">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0" />
        </Border.RenderTransform>
        <StackPanel>
        <!-- The full flyout. Compact mode (see FlyoutWindow.Compact) shows CompactContent below instead. -->
        <StackPanel x:Name="FullContent">
            <!-- Slim header: no title (the content says what this is), just settings and close,
                 small and quiet in the top-right corner. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-8,4">
                <!-- The gear glyph draws smaller than the close glyph at the same size, so they differ to match visually. -->
                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButtonStyle}"
                        Width="24" Height="24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                        ToolTip="{loc:Tr Flyout_Settings}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
                <Button Click="OnCloseClicked" Style="{StaticResource IconButtonStyle}"
                        Width="24" Height="24" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                        ToolTip="{loc:Tr Flyout_Close}" Margin="2,0,0,0">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
            </StackPanel>

            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
                    BorderThickness="0,0,0,0" BorderBrush="{DynamicResource WarningBrush}"
                    Visibility="{Binding BannerText, Converter={StaticResource StringToVisibility}}">
                <DockPanel LastChildFill="True">
                    <Border Background="{DynamicResource WarningBrush}" Width="3" CornerRadius="1.5" Margin="0,0,8,0" DockPanel.Dock="Left" />
                    <StackPanel>
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource WarningBrush}" />
                        <Button Content="{loc:Tr Flyout_SignIn}" Command="{Binding SignInCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Height="28" Padding="14,0" Margin="0,8,0,0"
                                ToolTip="{loc:Tr Flyout_SignInToolTip}"
                                Visibility="{Binding CanSignIn, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:UsageRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footer: last update and refresh on the right; on the left, sitting in the corner,
                 the creature that acts out the usage, if the user wants it here. -->
            <DockPanel Margin="0,4,0,0" LastChildFill="False">
            <views:MascotView DockPanel.Dock="Left" VerticalAlignment="Bottom" Mood="{Binding MascotMood}"
                              Animation="{Binding MascotAnimation}"
                              Visibility="{Binding ShowMascot, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding LastUpdatedText}" ToolTip="{Binding LastUpdatedToolTip}"
                           Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource BooleanInverter}}"
                        Style="{StaticResource RefreshIconButtonStyle}" ToolTip="{loc:Tr Flyout_RefreshNow}"
                        Width="24" Height="24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center" Margin="2,0,-4,0">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
            </StackPanel>
            </DockPanel>
        </StackPanel>
        <!-- Compact mode: the flyout cut down to what the taskbar bars show — one line per row
             (short name, bar, percentage, time left) and nothing else, as wide as that takes.
             No buttons: it's closed and set up from the tray icon, and a double-click brings
             the full flyout back. A problem that would show as a banner still gets a line. -->
        <StackPanel x:Name="CompactContent" Visibility="Collapsed">
            <StackPanel.ToolTip>
                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <ItemsControl ItemsSource="{Binding AllRows}" Focusable="False"
                              ItemTemplate="{StaticResource UsageRowSummaryTemplate}" />
                </ToolTip>
            </StackPanel.ToolTip>
            <StackPanel Orientation="Horizontal">
            <views:MascotView Margin="0,0,8,0" VerticalAlignment="Center" Mood="{Binding MascotMood}"
                              Animation="{Binding MascotAnimation}"
                              Visibility="{Binding ShowMascot, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Grid.IsSharedSizeScope="True" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ShortLabel}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding DataContext.CompactShowLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                            <ProgressBar Grid.Column="1" Value="{Binding Percentage, Mode=OneWay}" Minimum="0" Maximum="100"
                                         Height="4" Margin="0,1,6,0" VerticalAlignment="Center"
                                         Background="{DynamicResource ProgressTrackBrush}"
                                         Style="{StaticResource UsageProgressBarStyle}" />
                            <TextBlock Grid.Column="2" Text="{Binding PercentageText}" FontSize="11" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="{Binding DataContext.CompactShowPercentage, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                            <!-- When this row resets. Which edge the rows line up on depends on what it is (see ShortResetAlignment). -->
                            <TextBlock Grid.Column="3" Text="{Binding ShortResetText}" TextAlignment="{Binding ShortResetAlignment}" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding DataContext.CompactShowResetTime, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding BannerText}" FontSize="11" TextWrapping="Wrap" MaxWidth="220" HorizontalAlignment="Left" Margin="0,4,0,0"
                       Foreground="{DynamicResource WarningBrush}"
                       Visibility="{Binding BannerText, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>
        </StackPanel>
    </Border>
    <!-- Invisible resize grips along the panel's edges and corners (the borderless window has no
         frame of its own). Dragging one scales the whole flyout, text included, keeping its
         proportions. Kept over the panel by code-behind, which gives it the panel's margin. -->
    <Grid x:Name="ResizeGrips" Margin="24,24,24,28">
        <Grid.Resources>
            <Style TargetType="Rectangle">
                <Setter Property="Fill" Value="Transparent" />
                <EventSetter Event="MouseLeftButtonDown" Handler="OnGripMouseLeftButtonDown" />
                <EventSetter Event="MouseMove" Handler="OnGripMouseMove" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnGripMouseLeftButtonUp" />
                <EventSetter Event="LostMouseCapture" Handler="OnGripLostMouseCapture" />
            </Style>
        </Grid.Resources>
        <!-- Tag = which way the edge moves: horizontal, vertical (-1 left/up, 1 right/down, 0 fixed). -->
        <Rectangle Tag="-1,0" Width="5" Margin="0,10" HorizontalAlignment="Left" Cursor="SizeWE" />
        <Rectangle Tag="1,0" Width="5" Margin="0,10" HorizontalAlignment="Right" Cursor="SizeWE" />
        <Rectangle Tag="0,-1" Height="5" Margin="10,0" VerticalAlignment="Top" Cursor="SizeNS" />
        <Rectangle Tag="0,1" Height="5" Margin="10,0" VerticalAlignment="Bottom" Cursor="SizeNS" />
        <Rectangle Tag="-1,-1" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
        <Rectangle Tag="1,-1" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
        <Rectangle Tag="-1,1" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
        <Rectangle Tag="1,1" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
    </Grid>
    </Grid>
</Window>
