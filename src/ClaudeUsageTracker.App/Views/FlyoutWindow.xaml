<Window x:Class="ClaudeUsageTracker.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        Title="Claude Usage Tracker"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Deactivated="OnDeactivated">
    <Border Background="#FF202020" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="True" Margin="0,0,0,10" Background="Transparent"
                       MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="13" Foreground="White"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Content="⚙" Command="{Binding OpenSettingsCommand}" DockPanel.Dock="Right"
                        Width="26" Height="26" Margin="4,0,0,0" />
                <Button Content="⟳" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsRefreshing, Converter={StaticResource BooleanInverter}}"
                        DockPanel.Dock="Right" Width="26" Height="26" Margin="4,0,0,0" />
                <ToggleButton Content="📌" IsChecked="{Binding IsPinned}" DockPanel.Dock="Right"
                              Width="26" Height="26" ToolTip="Keep this window open">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="#55FFFFFF" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#FF3A6EA5" />
                                    <Setter Property="BorderBrush" Value="#FF5A8EC5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </DockPanel>

            <Border Background="#332C2C2C" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                    Visibility="{Binding BannerText, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="11" Foreground="#FFFFC107" />
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:UsageRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding LastUpdatedText}" Foreground="#88FFFFFF" FontSize="10"
                       Margin="0,6,0,0" HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</Window>
