<Window x:Class="ClaudeUsageTracker.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        xmlns:loc="clr-namespace:ClaudeUsageTracker.App.Localization"
        TextOptions.TextFormattingMode="Display"
        FontSize="{StaticResource BodyFontSize}"
        Title="Claude Usage Tracker"
        Width="348" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <!-- The margin is transparent room for FlyoutShadowEffect (blur 24, offset 4 down) and the
         slide-in animation; without it the shadow is clipped to the window's square bounds and
         shows as a faint rectangle behind the rounded corners. Width = 300 card + 2 x 24. -->
    <!-- The whole panel is a drag handle (buttons excluded), so the header can stay minimal. -->
    <Border x:Name="RootPanel" Margin="24,24,24,28" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,8,16,16"
            Effect="{StaticResource FlyoutShadowEffect}" RenderTransformOrigin="0.5,0"
            MouseLeftButtonDown="OnPanelMouseLeftButtonDown">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0" />
        </Border.RenderTransform>
        <StackPanel>
            <!-- Slim header: no title (the content says what this is), just settings and close,
                 small and quiet in the top-right corner. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-8,4">
                <!-- The gear glyph draws smaller than the close glyph at the same size, so they differ to match visually. -->
                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButtonStyle}"
                        Width="24" Height="24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                        ToolTip="{loc:Tr Flyout_Settings}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
                <Button Click="OnCloseClicked" Style="{StaticResource IconButtonStyle}"
                        Width="24" Height="24" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                        ToolTip="{loc:Tr Flyout_Close}" Margin="2,0,0,0">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
            </StackPanel>

            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
                    BorderThickness="0,0,0,0" BorderBrush="{DynamicResource WarningBrush}"
                    Visibility="{Binding BannerText, Converter={StaticResource StringToVisibility}}">
                <DockPanel LastChildFill="True">
                    <Border Background="{DynamicResource WarningBrush}" Width="3" CornerRadius="1.5" Margin="0,0,8,0" DockPanel.Dock="Left" />
                    <StackPanel>
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource WarningBrush}" />
                        <Button Content="{loc:Tr Flyout_SignIn}" Command="{Binding SignInCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Height="28" Padding="14,0" Margin="0,8,0,0"
                                ToolTip="{loc:Tr Flyout_SignInToolTip}"
                                Visibility="{Binding CanSignIn, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:UsageRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <TextBlock Text="{Binding LastUpdatedText}" ToolTip="{Binding LastUpdatedToolTip}"
                           Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource BooleanInverter}}"
                        Style="{StaticResource RefreshIconButtonStyle}" ToolTip="{loc:Tr Flyout_RefreshNow}"
                        Width="24" Height="24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center" Margin="2,0,-4,0">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
