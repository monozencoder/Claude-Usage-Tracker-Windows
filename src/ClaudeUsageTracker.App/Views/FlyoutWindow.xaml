<Window x:Class="ClaudeUsageTracker.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        Title="Claude Usage Tracker"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Deactivated="OnDeactivated">
    <Border x:Name="RootPanel" Background="{StaticResource WindowBackgroundBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16"
            Effect="{StaticResource FlyoutShadowEffect}" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0" />
        </Border.RenderTransform>
        <StackPanel>
            <DockPanel LastChildFill="True" Margin="0,0,0,12" Background="Transparent"
                       MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Command="{Binding OpenSettingsCommand}" DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Settings" Margin="4,0,0,0">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
                <Button Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource BooleanInverter}}"
                        Style="{StaticResource RefreshIconButtonStyle}" ToolTip="Refresh now" DockPanel.Dock="Right" Margin="4,0,0,0">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
                <ToggleButton IsChecked="{Binding IsPinned}" DockPanel.Dock="Right"
                              Style="{StaticResource PinToggleButtonStyle}" Margin="4,0,0,0">
                    <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFontFamily}" />
                </ToggleButton>
            </DockPanel>

            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
                    BorderThickness="0,0,0,0" Visibility="{Binding BannerText, Converter={StaticResource StringToVisibility}}">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FFFFC107" />
                </Border.BorderBrush>
                <DockPanel LastChildFill="True">
                    <Border Background="#FFFFC107" Width="3" CornerRadius="1.5" Margin="0,0,8,0" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="11" Foreground="#FFFFC107" />
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:UsageRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10"
                       Margin="0,6,0,0" HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</Window>
