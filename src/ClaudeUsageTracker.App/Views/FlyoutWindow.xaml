<Window x:Class="ClaudeUsageTracker.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        TextOptions.TextFormattingMode="Display"
        Title="Claude Usage Tracker"
        Width="348" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <!-- The margin is transparent room for FlyoutShadowEffect (blur 24, offset 4 down) and the
         slide-in animation; without it the shadow is clipped to the window's square bounds and
         shows as a faint rectangle behind the rounded corners. Width = 300 card + 2 x 24. -->
    <Border x:Name="RootPanel" Margin="24,24,24,28" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16"
            Effect="{StaticResource FlyoutShadowEffect}" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0" />
        </Border.RenderTransform>
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,12" Background="Transparent"
                       MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Click="OnCloseClicked" DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Close" Margin="4,0,0,0">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
                <Button Click="OnMinimizeClicked" DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Minimize to tray" Margin="4,0,0,0">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Settings" Margin="4,0,0,0">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
            </DockPanel>

            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
                    BorderThickness="0,0,0,0" BorderBrush="{DynamicResource WarningBrush}"
                    Visibility="{Binding BannerText, Converter={StaticResource StringToVisibility}}">
                <DockPanel LastChildFill="True">
                    <Border Background="{DynamicResource WarningBrush}" Width="3" CornerRadius="1.5" Margin="0,0,8,0" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:UsageRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <TextBlock Text="{Binding LastUpdatedText}" ToolTip="{Binding LastUpdatedToolTip}"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource BooleanInverter}}"
                        Style="{StaticResource RefreshIconButtonStyle}" ToolTip="Refresh now"
                        Width="22" Height="22" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center" Margin="2,0,-4,0">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
