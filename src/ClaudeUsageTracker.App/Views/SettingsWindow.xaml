<Window x:Class="ClaudeUsageTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClaudeUsageTracker.App.Localization"
        TextOptions.TextFormattingMode="Display"
        FontSize="{StaticResource BodyFontSize}"
        Title="{loc:Tr Settings_Title}"
        Icon="/Assets/AppIcon.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- Inline spin buttons inside the NumberBox-style interval field. -->
        <Style x:Key="SpinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rounded card holding related rows, like the Windows 11 Settings app. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- One option of a segmented control (RadioButtons sharing a parent form one group). -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Height="28" MinWidth="72" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="{loc:Tr Settings_Account}" Style="{StaticResource BodyStrongTextStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding AccountSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource CaptionTextStyle}"
                    Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,-4,0,10"
                   Visibility="{Binding ShowInstallLink, Converter={StaticResource BoolToVisibility}}">
            <Hyperlink NavigateUri="https://docs.anthropic.com/en/docs/claude-code/setup" RequestNavigate="OnInstallLinkNavigate"
                       Foreground="{DynamicResource AccentBrush}"><Run Text="{loc:Tr Settings_InstallLink}" /></Hyperlink>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <!-- Runs the CLI's own browser sign-in; the app never handles OAuth itself. -->
            <Button Content="{Binding AccountActionText}" Command="{Binding SignInCommand}" Height="32" Padding="14,0" Margin="0,0,8,0"
                    ToolTip="{loc:Tr Settings_SignInToolTip}"
                    Visibility="{Binding AccountActionText, Converter={StaticResource StringToVisibility}}" />
            <Button Content="{loc:Tr Settings_TestConnection}" Height="32" Padding="14,0" Command="{Binding TestConnectionCommand}"
                    ToolTip="{loc:Tr Settings_TestConnectionToolTip}" />
        </StackPanel>
        <!-- Test connection / sign-in result, right under the buttons that produce it. -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,-8,0,18"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Interval and token-free mode share one card: the toggle fixes the interval at 10 minutes. -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,18">
            <StackPanel>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Tr Settings_RefreshInterval}" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <!-- Always visible: the per-refresh cost, or the error in red while the typed
                             value can't be used. The model line below is hidden (not collapsed) in
                             token-free mode, which prompts no model, so the row keeps its height. -->
                        <TextBlock Text="{Binding RefreshIntervalHint}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRefreshIntervalError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ProbeModelText}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshIntervalEditable}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- NumberBox-style field. Disabled in token-free mode, which always refreshes every 10 minutes. -->
                        <Border Height="32" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                IsEnabled="{Binding IsRefreshIntervalEditable}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <!-- Digits only: IME is disabled so full-width input can't sneak in, and
                                     typing/pasting is filtered in code-behind. Up/Down and the wheel step the value. -->
                                <TextBox x:Name="RefreshIntervalBox" Width="48" MaxLength="4" TextAlignment="Right"
                                         Background="Transparent" BorderThickness="0" Padding="4,0,2,0" VerticalContentAlignment="Center"
                                         Text="{Binding RefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                         InputMethod.IsInputMethodEnabled="False"
                                         ToolTip="{Binding RefreshIntervalToolTip}"
                                         PreviewTextInput="OnRefreshIntervalPreviewTextInput"
                                         PreviewKeyDown="OnRefreshIntervalPreviewKeyDown"
                                         PreviewMouseWheel="OnRefreshIntervalPreviewMouseWheel"
                                         LostKeyboardFocus="OnRefreshIntervalLostFocus"
                                         DataObject.Pasting="OnRefreshIntervalPasting" />
                                <TextBlock Text="{loc:Tr Settings_Seconds}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <!-- Glyphs need an explicit FontFamily: the implicit TextBlock style would
                                     otherwise swap in the UI font and render them as boxes. -->
                                <Button Style="{StaticResource SpinButtonStyle}"
                                        Command="{Binding IncreaseRefreshIntervalCommand}" ToolTip="{loc:Tr Settings_Increase}">
                                    <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFontFamily}" />
                                </Button>
                                <Button Style="{StaticResource SpinButtonStyle}" Margin="0,0,3,0"
                                        Command="{Binding DecreaseRefreshIntervalCommand}" ToolTip="{loc:Tr Settings_Decrease}">
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Live estimate for the typed interval. Hidden (not collapsed) in token-free
                             mode, where no tokens are used, so the row keeps its height. -->
                        <TextBlock Text="{Binding TokensPerHourText}" HorizontalAlignment="Right" Margin="0,4,2,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshIntervalEditable}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AvoidTokenUsage}" Padding="0" Margin="16,12"
                          AutomationProperties.Name="{loc:Tr Settings_AvoidTokens}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_AvoidTokens}" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Tr Settings_AvoidTokensDescription}" Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <TextBlock Text="{loc:Tr Settings_Appearance}" Style="{StaticResource BodyStrongTextStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5"
                HorizontalAlignment="Left" Margin="0,0,0,18" Padding="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_ThemeSystem}"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_ThemeLight}"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_ThemeDark}"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{loc:Tr Settings_Language}" Style="{StaticResource BodyStrongTextStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5"
                HorizontalAlignment="Left" Margin="0,0,0,18" Padding="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_LanguageSystem}" GroupName="Language"
                             IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                <!-- Language names stay in their own language so each is findable whatever the UI shows. -->
                <RadioButton Style="{StaticResource SegmentStyle}" Content="English" GroupName="Language"
                             IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=English}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="日本語" GroupName="Language"
                             IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=Japanese}" />
            </StackPanel>
        </Border>

        <CheckBox Content="{loc:Tr Settings_Notifications}" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="{loc:Tr Settings_LaunchAtLogin}" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="{loc:Tr Settings_ShowOnStartup}" IsChecked="{Binding ShowFlyoutOnStartup}" Margin="0,0,0,10" />
        <CheckBox Content="{loc:Tr Settings_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" />
    </StackPanel>
</Window>
