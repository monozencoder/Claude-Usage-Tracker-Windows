<Window x:Class="ClaudeUsageTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextOptions.TextFormattingMode="Display"
        Title="Claude Usage Tracker — Settings"
        Icon="/Assets/AppIcon.ico"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="StepButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- One option of a segmented control (RadioButtons sharing a parent form one group). -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Height="24" MinWidth="64" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Claude Code CLI" FontWeight="SemiBold" FontSize="13"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding CredentialsSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                    Margin="0,0,0,10" TextWrapping="Wrap" />
        <Button Content="Test connection" Height="30" HorizontalAlignment="Left" Padding="14,0"
                Click="OnTestConnectionClicked" Margin="0,0,0,18" />

        <TextBlock Text="Refresh interval" FontWeight="SemiBold" FontSize="13"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Style="{StaticResource StepButtonStyle}" Command="{Binding DecreaseRefreshIntervalCommand}"
                    ToolTip="Decrease by 5 seconds">
                <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
            </Button>
            <!-- Digits only: IME is disabled so full-width input can't sneak in, and
                 typing/pasting is filtered in code-behind. Up/Down and the wheel step the value. -->
            <TextBox x:Name="RefreshIntervalBox" Width="64" Height="28" MaxLength="4" TextAlignment="Center" Margin="4,0"
                     Text="{Binding RefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                     InputMethod.IsInputMethodEnabled="False"
                     ToolTip="↑ / ↓ or mouse wheel to adjust by 5 seconds"
                     PreviewTextInput="OnRefreshIntervalPreviewTextInput"
                     PreviewKeyDown="OnRefreshIntervalPreviewKeyDown"
                     PreviewMouseWheel="OnRefreshIntervalPreviewMouseWheel"
                     LostKeyboardFocus="OnRefreshIntervalLostFocus"
                     DataObject.Pasting="OnRefreshIntervalPasting" />
            <Button Style="{StaticResource StepButtonStyle}" Command="{Binding IncreaseRefreshIntervalCommand}"
                    ToolTip="Increase by 5 seconds">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" />
            </Button>
            <TextBlock Text="seconds" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding RefreshIntervalHint}" FontSize="11" Margin="0,0,0,18">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRefreshIntervalValid}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="13"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5"
                HorizontalAlignment="Left" Margin="0,0,0,18" Padding="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentStyle}" Content="System"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="Light"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="Dark"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
            </StackPanel>
        </Border>

        <CheckBox Content="Enable threshold notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="Launch at Windows login" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="Show window on startup" IsChecked="{Binding ShowFlyoutOnStartup}" Margin="0,0,0,16" />

        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="84" Height="30" Margin="0,0,8,0" Click="OnCancelClicked" />
            <Button Content="Save" Width="84" Height="30" Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    IsEnabled="{Binding CanSave}" Click="OnSaveClicked" />
        </StackPanel>
    </StackPanel>
</Window>
