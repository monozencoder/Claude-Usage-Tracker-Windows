<Window x:Class="ClaudeUsageTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClaudeUsageTracker.App.Localization"
        xmlns:vm="clr-namespace:ClaudeUsageTracker.App.ViewModels"
        xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views"
        TextOptions.TextFormattingMode="Display"
        FontSize="{StaticResource BodyFontSize}"
        Title="{loc:Tr Settings_Title}"
        Icon="/Assets/AppIcon.ico"
        Width="800" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- Inline spin buttons inside the NumberBox-style interval field. -->
        <Style x:Key="SpinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Obsidian-style settings navigation =====
             A TabControl drawn as Obsidian's settings modal: a sidebar (background-secondary,
             hairline on its right edge) with a small group label and icon + label items, and
             the selected page on the right, scrolling on its own. -->
        <Style x:Key="NavTabItemStyle" TargetType="TabItem">
            <!-- Pages inherit this, so it must be the theme's text color, not the system default. -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Height="30" Margin="0,0,0,2" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Tag carries the Segoe Fluent glyph for the item. -->
                                <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFontFamily}" FontSize="14" Width="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Label" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource BodyTextStyle}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTabControlStyle" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="216" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <StackPanel Margin="12,20,12,12">
                                    <TextBlock Text="{loc:Tr Settings_NavOptions}" Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="SemiBold"
                                               TextOptions.TextFormattingMode="Ideal" Margin="8,0,0,6" />
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <!-- Obsidian centers the page in a readable column. -->
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  MaxWidth="680" Margin="32,24,32,32" />
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting group ("setting-group" in Obsidian): a softly tinted, rounded block of rows
             with no outline. -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- Drop-down item label, re-evaluated on every language switch (see ChoiceLabelConverter). -->
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource ChoiceLabel}">
                        <Binding />
                        <Binding Source="{x:Static loc:Loc.Instance}" Path="[Settings_Theme]" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>
        <!-- Page heading above its group, like Obsidian's setting headings. -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="4,0,0,12" />
        </Style>
        <!-- Common padding of a card row. -->
        <Style x:Key="CardRowStyle" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="16,14" />
        </Style>
        <!-- Row title (setting-item-name) and the description under it (setting-item-description). -->
        <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <!-- Hairline between the rows of a group, inset from its edges. -->
        <Style x:Key="CardDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        </Style>
        <!-- A card row that is a toggle: title and description on the left, switch on the right,
             whole row clickable. The two texts are set on the CheckBox as SettingRow.Title and
             SettingRow.Description. -->
        <Style x:Key="ToggleRowStyle" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchStyle}">
            <Setter Property="Margin" Value="16,14" />
            <Setter Property="AutomationProperties.Name" Value="{Binding (views:SettingRow.Title), RelativeSource={RelativeSource Self}}" />
            <!-- The title is the content, so that there is content for the template below to show. -->
            <Setter Property="Content" Value="{Binding (views:SettingRow.Title), RelativeSource={RelativeSource Self}}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{Binding (views:SettingRow.Description), RelativeSource={RelativeSource AncestorType=CheckBox}}"
                                       Style="{StaticResource RowDescriptionStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Any other card row: title and description on the left, and on the right whatever
             control the row holds. -->
        <Style TargetType="views:SettingRow">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="views:SettingRow">
                        <DockPanel Margin="16,14">
                            <ContentPresenter DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource RowDescriptionStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A row's drop-down of ChoiceOptions, named after its row for screen readers. -->
        <Style x:Key="SettingComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="SelectedValuePath" Value="Value" />
            <Setter Property="ItemTemplate" Value="{StaticResource ChoiceTemplate}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource AncestorType=views:SettingRow}}" />
        </Style>
    </Window.Resources>
    <!-- Settings layout modeled on Obsidian's settings: a sidebar of pages on the left, and on
         the right the selected page as a heading and one group of rows; every row has a title
         and a description on the left and its control on the right. -->
    <TabControl Style="{StaticResource NavTabControlStyle}" Background="Transparent" BorderThickness="0">
        <TabItem Header="{loc:Tr Settings_Account}" Tag="&#xE77B;">
            <StackPanel>
                <TextBlock Text="{loc:Tr Settings_Account}" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource CardRowStyle}">
                            <!-- Runs the CLI's own browser sign-in; the app never handles OAuth itself. -->
                            <Button DockPanel.Dock="Right" Content="{Binding AccountActionText}" Command="{Binding SignInCommand}"
                                    Height="30" Padding="14,0" Margin="16,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{loc:Tr Settings_SignInToolTip}"
                                    Visibility="{Binding AccountActionText, Converter={StaticResource StringToVisibility}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Settings_AccountRow}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{Binding AccountSummary}" Style="{StaticResource RowDescriptionStyle}" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}"
                                           Visibility="{Binding ShowInstallLink, Converter={StaticResource BoolToVisibility}}">
                                    <Hyperlink NavigateUri="https://docs.anthropic.com/en/docs/claude-code/setup" RequestNavigate="OnInstallLinkNavigate"
                                               Foreground="{DynamicResource AccentTextBrush}"><Run Text="{loc:Tr Settings_InstallLink}" /></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_TestConnection}" Description="{loc:Tr Settings_TestConnectionDescription}">
                            <Button Content="{loc:Tr Settings_TestButton}" Command="{Binding TestConnectionCommand}"
                                    Height="30" Padding="14,0"
                                    ToolTip="{loc:Tr Settings_TestConnectionToolTip}" />
                        </views:SettingRow>
                        <!-- Test connection / sign-in result, right under the buttons that produce it. -->
                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="16,0,16,14"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>
        <TabItem Header="{loc:Tr Settings_SectionUsage}" Tag="&#xE9D2;">
            <StackPanel>
                <!-- The mode comes first: the interval below only applies when token-free mode is off. -->
                <TextBlock Text="{loc:Tr Settings_SectionUsage}" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding AvoidTokenUsage}"
                                  views:SettingRow.Title="{loc:Tr Settings_AvoidTokens}" views:SettingRow.Description="{loc:Tr Settings_AvoidTokensDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <Grid Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Dimmed with the box in token-free mode: the interval and its cost only apply when it's off. -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshIntervalEditable}" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{loc:Tr Settings_RefreshInterval}" Style="{StaticResource BodyTextStyle}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <!-- Always visible: the per-refresh cost, or the error in red while the typed
                                     value can't be used. The model line below is hidden (not collapsed) in
                                     token-free mode, which prompts no model, so the row keeps its height. -->
                                <TextBlock Text="{Binding RefreshIntervalHint}" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRefreshIntervalError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ProbeModelText}" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRefreshIntervalEditable}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- NumberBox-style field. Disabled in token-free mode, which always refreshes every 5 minutes. -->
                                <Border Height="30" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        IsEnabled="{Binding IsRefreshIntervalEditable}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Digits only: IME is disabled so full-width input can't sneak in, and
                                             typing/pasting is filtered in code-behind. Up/Down and the wheel step the value. -->
                                        <TextBox x:Name="RefreshIntervalBox" Width="48" MaxLength="4" TextAlignment="Right"
                                                 Background="Transparent" BorderThickness="0" Padding="4,0,2,0" VerticalContentAlignment="Center"
                                                 Text="{Binding RefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 InputMethod.IsInputMethodEnabled="False"
                                                 ToolTip="{Binding RefreshIntervalToolTip}"
                                                 PreviewTextInput="OnRefreshIntervalPreviewTextInput"
                                                 PreviewKeyDown="OnRefreshIntervalPreviewKeyDown"
                                                 PreviewMouseWheel="OnRefreshIntervalPreviewMouseWheel"
                                                 LostKeyboardFocus="OnRefreshIntervalLostFocus"
                                                 DataObject.Pasting="OnRefreshIntervalPasting" />
                                        <TextBlock Text="{loc:Tr Settings_Seconds}" Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                        <!-- Glyphs need an explicit FontFamily: the implicit TextBlock style would
                                             otherwise swap in the UI font and render them as boxes. -->
                                        <Button Style="{StaticResource SpinButtonStyle}"
                                                Command="{Binding IncreaseRefreshIntervalCommand}" ToolTip="{loc:Tr Settings_Increase}">
                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFontFamily}" />
                                        </Button>
                                        <Button Style="{StaticResource SpinButtonStyle}" Margin="0,0,3,0"
                                                Command="{Binding DecreaseRefreshIntervalCommand}" ToolTip="{loc:Tr Settings_Decrease}">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!-- Live estimate for the typed interval. Hidden (not collapsed) in token-free
                                     mode, where no tokens are used, so the row keeps its height. -->
                                <TextBlock Text="{Binding TokensPerHourText}" HorizontalAlignment="Right" Margin="0,4,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRefreshIntervalEditable}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>
        <TabItem Header="{loc:Tr Settings_Appearance}" Tag="&#xE790;">
            <StackPanel>
                <TextBlock Text="{loc:Tr Settings_Appearance}" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <views:SettingRow Title="{loc:Tr Settings_Theme}" Description="{loc:Tr Settings_ThemeDescription}">
                            <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                                      ItemsSource="{x:Static vm:SettingsViewModel.ThemeOptions}" SelectedValue="{Binding Theme}" />
                        </views:SettingRow>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_Language}" Description="{loc:Tr Settings_LanguageDescription}">
                            <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                                      ItemsSource="{x:Static vm:SettingsViewModel.LanguageOptions}" SelectedValue="{Binding Language}" />
                        </views:SettingRow>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_ResetTime}" Description="{loc:Tr Settings_ResetTimeDescription}">
                            <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                                      ItemsSource="{x:Static vm:SettingsViewModel.ResetTimeDisplayOptions}" SelectedValue="{Binding ResetTimeDisplay}" />
                        </views:SettingRow>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_VisibleRows}" Description="{loc:Tr Settings_VisibleRowsDescription}">
                            <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                                      ItemsSource="{x:Static vm:SettingsViewModel.VisibleRowsOptions}" SelectedValue="{Binding VisibleRows}" />
                        </views:SettingRow>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding CompactShowLabels}"
                                  views:SettingRow.Title="{loc:Tr Settings_CompactLabels}" views:SettingRow.Description="{loc:Tr Settings_CompactLabelsDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding CompactShowResetTime}"
                                  views:SettingRow.Title="{loc:Tr Settings_CompactResetTime}" views:SettingRow.Description="{loc:Tr Settings_CompactResetTimeDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_TrayIcon}" Description="{loc:Tr Settings_TrayIconDescription}">
                            <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                                      ItemsSource="{x:Static vm:SettingsViewModel.TrayIconStyleOptions}" SelectedValue="{Binding TrayIconStyle}" />
                        </views:SettingRow>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_Opacity}" Description="{loc:Tr Settings_OpacityDescription}">
                            <!-- Applied as it's dragged, so an open flyout previews the value. The button
                                 puts it back to 100% in one click; disabled while already there. -->
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                        Command="{Binding ResetFlyoutOpacityCommand}" ToolTip="{loc:Tr Settings_ResetTo100}"
                                        AutomationProperties.Name="{loc:Tr Settings_ResetTo100}">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" />
                                </Button>
                                <TextBlock Text="{Binding FlyoutOpacityPercent, StringFormat={}{0}%}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Width="36" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Style="{StaticResource SliderStyle}" Width="150" VerticalAlignment="Center"
                                        Minimum="{Binding MinFlyoutOpacityPercent, Mode=OneTime}"
                                        Maximum="{Binding MaxFlyoutOpacityPercent, Mode=OneTime}"
                                        Value="{Binding FlyoutOpacityPercent}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                        IsMoveToPointEnabled="True"
                                        AutomationProperties.Name="{loc:Tr Settings_Opacity}" />
                            </StackPanel>
                        </views:SettingRow>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_Scale}" Description="{loc:Tr Settings_ScaleDescription}">
                            <!-- Same scale as dragging the flyout's edges; applied as it's dragged, like the opacity. -->
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                        Command="{Binding ResetFlyoutScaleCommand}" ToolTip="{loc:Tr Settings_ResetTo100}"
                                        AutomationProperties.Name="{loc:Tr Settings_ResetTo100}">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" />
                                </Button>
                                <TextBlock Text="{Binding FlyoutScalePercent, StringFormat={}{0}%}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Width="36" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Style="{StaticResource SliderStyle}" Width="150" VerticalAlignment="Center"
                                        Minimum="{Binding MinFlyoutScalePercent, Mode=OneTime}"
                                        Maximum="{Binding MaxFlyoutScalePercent, Mode=OneTime}"
                                        Value="{Binding FlyoutScalePercent}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                        IsMoveToPointEnabled="True"
                                        AutomationProperties.Name="{loc:Tr Settings_Scale}" />
                            </StackPanel>
                        </views:SettingRow>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding FlyoutCompact}"
                                  views:SettingRow.Title="{loc:Tr Settings_FlyoutCompact}" views:SettingRow.Description="{loc:Tr Settings_FlyoutCompactDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding FlyoutShowMascot}"
                                  views:SettingRow.Title="{loc:Tr Settings_FlyoutMascot}" views:SettingRow.Description="{loc:Tr Settings_FlyoutMascotDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <views:SettingRow Title="{loc:Tr Settings_MascotAnimation}" Description="{loc:Tr Settings_MascotAnimationDescription}" IsEnabled="{Binding CanAnimateMascot}">
                            <ComboBox Style="{StaticResource SettingComboStyle}" Width="150"
                                      ItemsSource="{x:Static vm:SettingsViewModel.MascotAnimationOptions}" SelectedValue="{Binding MascotAnimation}" />
                        </views:SettingRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>
        <TabItem Header="{loc:Tr Settings_SectionGeneral}" Tag="&#xE713;">
            <StackPanel>
                <TextBlock Text="{loc:Tr Settings_SectionGeneral}" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding NotificationsEnabled}"
                                  views:SettingRow.Title="{loc:Tr Settings_Notifications}" views:SettingRow.Description="{loc:Tr Settings_NotificationsDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <StackPanel Style="{StaticResource CardRowStyle}" IsEnabled="{Binding NotificationsEnabled}">
                            <TextBlock Text="{loc:Tr Settings_Thresholds}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{Binding NotificationThresholdsHint}" Style="{StaticResource RowDescriptionStyle}" />
                            <!-- One chip per threshold, in ascending order, each with its own remove button;
                                 then a chip-shaped box to add another, until the list is full. -->
                            <WrapPanel Margin="0,10,0,0">
                                <WrapPanel.Resources>
                                    <Style x:Key="ChipStyle" TargetType="Border">
                                        <Setter Property="Height" Value="30" />
                                        <Setter Property="CornerRadius" Value="15" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Width" Value="22" />
                                        <Setter Property="Height" Value="22" />
                                        <Setter Property="FontSize" Value="9" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </WrapPanel.Resources>
                                <ItemsControl ItemsSource="{Binding NotificationThresholds}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ChipStyle}" Padding="12,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StringFormat={}{0}%}" Style="{StaticResource BodyTextStyle}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource ChipButtonStyle}" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RemoveThresholdCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{loc:Tr Settings_ThresholdRemove}" AutomationProperties.Name="{loc:Tr Settings_ThresholdRemove}">
                                                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource ChipStyle}" Padding="8,0,4,0"
                                        Visibility="{Binding CanAddMoreThresholds, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Digits only, as in the interval box: IME off, typing filtered. Enter adds. -->
                                        <TextBox Width="30" MaxLength="3" TextAlignment="Right" Background="Transparent" BorderThickness="0"
                                                 Padding="0" VerticalAlignment="Center"
                                                 Text="{Binding NewThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                                 InputMethod.IsInputMethodEnabled="False"
                                                 PreviewTextInput="OnRefreshIntervalPreviewTextInput"
                                                 ToolTip="{loc:Tr Settings_ThresholdNew}" AutomationProperties.Name="{loc:Tr Settings_ThresholdNew}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddThresholdCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="%" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                                        <Button Style="{StaticResource ChipButtonStyle}" FontSize="10" Margin="4,0,0,0"
                                                Command="{Binding AddThresholdCommand}"
                                                ToolTip="{loc:Tr Settings_ThresholdAdd}" AutomationProperties.Name="{loc:Tr Settings_ThresholdAdd}">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!-- Back to the defaults in one click, like the sliders' reset buttons; disabled while already there. -->
                                <Button Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                        Command="{Binding ResetThresholdsCommand}" ToolTip="{Binding ResetThresholdsToolTip}"
                                        AutomationProperties.Name="{Binding ResetThresholdsToolTip}">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding WeeklyNotificationsEnabled}" IsEnabled="{Binding NotificationsEnabled}"
                                  views:SettingRow.Title="{loc:Tr Settings_WeeklyNotifications}" views:SettingRow.Description="{loc:Tr Settings_WeeklyNotificationsDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding LaunchAtLoginEnabled}"
                                  views:SettingRow.Title="{loc:Tr Settings_LaunchAtLogin}" views:SettingRow.Description="{loc:Tr Settings_LaunchAtLoginDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding ShowFlyoutOnStartup}"
                                  views:SettingRow.Title="{loc:Tr Settings_ShowOnStartup}" views:SettingRow.Description="{loc:Tr Settings_ShowOnStartupDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding AlwaysOnTop}"
                                  views:SettingRow.Title="{loc:Tr Settings_AlwaysOnTop}" views:SettingRow.Description="{loc:Tr Settings_AlwaysOnTopDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding FlyoutClickThrough}"
                                  views:SettingRow.Title="{loc:Tr Settings_FlyoutClickThrough}" views:SettingRow.Description="{loc:Tr Settings_FlyoutClickThroughDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding ShowTaskbarBar}"
                                  views:SettingRow.Title="{loc:Tr Settings_TaskbarBar}" views:SettingRow.Description="{loc:Tr Settings_TaskbarBarDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding ShowTaskbarBarOverFullScreen}" IsEnabled="{Binding ShowTaskbarBar}"
                                  views:SettingRow.Title="{loc:Tr Settings_TaskbarBarOverFullScreen}" views:SettingRow.Description="{loc:Tr Settings_TaskbarBarOverFullScreenDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding TaskbarBarClickThrough}" IsEnabled="{Binding ShowTaskbarBar}"
                                  views:SettingRow.Title="{loc:Tr Settings_TaskbarBarClickThrough}" views:SettingRow.Description="{loc:Tr Settings_TaskbarBarClickThroughDescription}" />
                        <Border Style="{StaticResource CardDividerStyle}" />
                        <CheckBox Style="{StaticResource ToggleRowStyle}" IsChecked="{Binding TaskbarBarShowMascot}" IsEnabled="{Binding ShowTaskbarBar}"
                                  views:SettingRow.Title="{loc:Tr Settings_TaskbarBarMascot}" views:SettingRow.Description="{loc:Tr Settings_TaskbarBarMascotDescription}" />
                        <!-- One row per connected monitor: the switch puts the bars on its taskbar, the slider
                             shifts them. Only meaningful while the bars are shown at all. -->
                        <ItemsControl ItemsSource="{Binding TaskbarBarDisplays}" IsEnabled="{Binding ShowTaskbarBar}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource CardDividerStyle}" />
                                        <views:SettingRow Title="{Binding Title}" Description="{Binding Description}">
                                            <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        IsEnabled="{Binding Show}" ToolTip="{loc:Tr Settings_TaskbarBarOffsetToolTip}">
                                                <!-- Back to the automatic place in one click; disabled while already there. -->
                                                <Button Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                                        Command="{Binding ResetOffsetCommand}" ToolTip="{loc:Tr Settings_TaskbarBarOffsetReset}"
                                                        AutomationProperties.Name="{loc:Tr Settings_TaskbarBarOffsetReset}">
                                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFontFamily}" />
                                                </Button>
                                                <TextBlock Text="{Binding Offset, StringFormat={}{0}px}" Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Width="48" TextAlignment="Right"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Slider Style="{StaticResource SliderStyle}" Width="150" VerticalAlignment="Center"
                                                        Minimum="{Binding MinOffset, Mode=OneTime}" Maximum="{Binding MaxOffset, Mode=OneTime}"
                                                        Value="{Binding Offset}"
                                                        TickFrequency="2" IsSnapToTickEnabled="True" SmallChange="2" LargeChange="20"
                                                        IsMoveToPointEnabled="True"
                                                        AutomationProperties.Name="{loc:Tr Settings_TaskbarBarOffsetToolTip}" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                                      IsChecked="{Binding Show}" AutomationProperties.Name="{Binding Title}" />
                                            </StackPanel>
                                        </views:SettingRow>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
