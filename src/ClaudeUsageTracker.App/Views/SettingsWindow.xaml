<Window x:Class="ClaudeUsageTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClaudeUsageTracker.App.Localization"
        TextOptions.TextFormattingMode="Display"
        FontSize="{StaticResource BodyFontSize}"
        Title="{loc:Tr Settings_Title}"
        Icon="/Assets/AppIcon.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="StepButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- One option of a segmented control (RadioButtons sharing a parent form one group). -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Height="28" MinWidth="72" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="{loc:Tr Settings_Account}" Style="{StaticResource BodyStrongTextStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding AccountSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource CaptionTextStyle}"
                    Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,-4,0,10"
                   Visibility="{Binding ShowInstallLink, Converter={StaticResource BoolToVisibility}}">
            <Hyperlink NavigateUri="https://docs.anthropic.com/en/docs/claude-code/setup" RequestNavigate="OnInstallLinkNavigate"
                       Foreground="{DynamicResource AccentBrush}"><Run Text="{loc:Tr Settings_InstallLink}" /></Hyperlink>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <!-- Runs the CLI's own browser sign-in; the app never handles OAuth itself. -->
            <Button Content="{Binding AccountActionText}" Command="{Binding SignInCommand}" Height="32" Padding="14,0" Margin="0,0,8,0"
                    ToolTip="{loc:Tr Settings_SignInToolTip}"
                    Visibility="{Binding AccountActionText, Converter={StaticResource StringToVisibility}}" />
            <Button Content="{loc:Tr Settings_TestConnection}" Height="32" Padding="14,0" Command="{Binding TestConnectionCommand}"
                    ToolTip="{loc:Tr Settings_TestConnectionToolTip}" />
        </StackPanel>

        <TextBlock Text="{loc:Tr Settings_RefreshInterval}" Style="{StaticResource BodyStrongTextStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <!-- Disabled in token-free mode, which always refreshes every 10 minutes. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding IsRefreshIntervalEditable}">
            <Button Style="{StaticResource StepButtonStyle}" Command="{Binding DecreaseRefreshIntervalCommand}"
                    ToolTip="{loc:Tr Settings_Decrease}">
                <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
            </Button>
            <!-- Digits only: IME is disabled so full-width input can't sneak in, and
                 typing/pasting is filtered in code-behind. Up/Down and the wheel step the value. -->
            <TextBox x:Name="RefreshIntervalBox" Width="72" Height="32" MaxLength="4" TextAlignment="Center" Margin="4,0"
                     Text="{Binding RefreshIntervalText, UpdateSourceTrigger=PropertyChanged}"
                     InputMethod.IsInputMethodEnabled="False"
                     ToolTip="{loc:Tr Settings_IntervalToolTip}"
                     PreviewTextInput="OnRefreshIntervalPreviewTextInput"
                     PreviewKeyDown="OnRefreshIntervalPreviewKeyDown"
                     PreviewMouseWheel="OnRefreshIntervalPreviewMouseWheel"
                     LostKeyboardFocus="OnRefreshIntervalLostFocus"
                     DataObject.Pasting="OnRefreshIntervalPasting" />
            <Button Style="{StaticResource StepButtonStyle}" Command="{Binding IncreaseRefreshIntervalCommand}"
                    ToolTip="{loc:Tr Settings_Increase}">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
            </Button>
            <TextBlock Text="{loc:Tr Settings_Seconds}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <!-- Always visible: the allowed range (and how to unlock shorter intervals), or the
             error in red while the typed value can't be saved. -->
        <TextBlock Text="{Binding RefreshIntervalHint}" TextWrapping="Wrap" Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRefreshIntervalError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Right under the interval: it fixes the interval at 10 minutes. -->
        <CheckBox Content="{loc:Tr Settings_AvoidTokens}" IsChecked="{Binding AvoidTokenUsage}" Margin="0,0,0,2" />
        <TextBlock Text="{loc:Tr Settings_AvoidTokensDescription}"
                   Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="26,0,0,18" />

        <TextBlock Text="{loc:Tr Settings_Appearance}" Style="{StaticResource BodyStrongTextStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5"
                HorizontalAlignment="Left" Margin="0,0,0,18" Padding="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_ThemeSystem}"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_ThemeLight}"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_ThemeDark}"
                             IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{loc:Tr Settings_Language}" Style="{StaticResource BodyStrongTextStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="5"
                HorizontalAlignment="Left" Margin="0,0,0,18" Padding="2">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr Settings_LanguageSystem}" GroupName="Language"
                             IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                <!-- Language names stay in their own language so each is findable whatever the UI shows. -->
                <RadioButton Style="{StaticResource SegmentStyle}" Content="English" GroupName="Language"
                             IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=English}" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="日本語" GroupName="Language"
                             IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=Japanese}" />
            </StackPanel>
        </Border>

        <CheckBox Content="{loc:Tr Settings_Notifications}" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="{loc:Tr Settings_LaunchAtLogin}" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="{loc:Tr Settings_ShowOnStartup}" IsChecked="{Binding ShowFlyoutOnStartup}" Margin="0,0,0,10" />
        <CheckBox Content="{loc:Tr Settings_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,16" />

        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Settings_Cancel}" Width="96" Height="32" Margin="0,0,8,0" Click="OnCancelClicked" />
            <Button Content="{loc:Tr Settings_Save}" Width="96" Height="32" Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
