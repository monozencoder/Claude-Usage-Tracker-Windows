<Window x:Class="ClaudeUsageTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage Tracker — Settings"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Claude Code CLI" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="{Binding CredentialsSummary}" Foreground="Gray" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
        <Button Content="Test connection" Height="28" HorizontalAlignment="Left" Padding="12,0" Click="OnTestConnectionClicked" Margin="0,0,0,12" />

        <TextBlock Text="Refresh interval (seconds)" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBox Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

        <CheckBox Content="Enable threshold notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,8" />
        <CheckBox Content="Launch at Windows login" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,0,0,12" />

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FF2E7D32" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="#FFC62828" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancelClicked" />
            <Button Content="Save" Width="80" IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverter}}" Click="OnSaveClicked" />
        </StackPanel>
    </StackPanel>
</Window>
