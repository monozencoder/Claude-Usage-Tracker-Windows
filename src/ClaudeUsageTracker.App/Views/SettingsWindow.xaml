<Window x:Class="ClaudeUsageTracker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage Tracker — Settings"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Claude Code CLI" FontWeight="SemiBold" FontSize="13"
                    Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding CredentialsSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                    Margin="0,0,0,10" TextWrapping="Wrap" />
        <Button Content="Test connection" Height="30" HorizontalAlignment="Left" Padding="14,0"
                Click="OnTestConnectionClicked" Margin="0,0,0,18" />

        <TextBlock Text="Refresh interval (seconds)" FontWeight="SemiBold" FontSize="13"
                    Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <TextBox Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="28"
                 HorizontalAlignment="Left" Margin="0,0,0,18" />

        <CheckBox Content="Enable threshold notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="Launch at Windows login" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,0,0,10" />
        <CheckBox Content="Show window on startup" IsChecked="{Binding ShowFlyoutOnStartup}" Margin="0,0,0,16" />

        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="84" Height="30" Margin="0,0,8,0" Click="OnCancelClicked" />
            <Button Content="Save" Width="84" Height="30" Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverter}}" Click="OnSaveClicked" />
        </StackPanel>
    </StackPanel>
</Window>
