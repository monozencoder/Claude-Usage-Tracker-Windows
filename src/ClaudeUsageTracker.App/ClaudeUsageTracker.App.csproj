<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeUsageTracker.Core\ClaudeUsageTracker.Core.csproj" />
    <ProjectReference Include="..\ClaudeUsageTracker.Platform\ClaudeUsageTracker.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <!--
    UseWindowsForms is only needed for Cursor.Position/Screen.FromPoint in WindowPositioner.
    Its implicit global usings (System.Drawing, System.Windows.Forms) collide with WPF's own
    (Application, UserControl, Brush, Color, MenuItem, ContextMenu, ...), so they're removed
    here; code that needs a WinForms/GDI+ type references it explicitly or via a local alias
    (see Views/WindowPositioner.cs, Tray/TrayIconController.cs).
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
