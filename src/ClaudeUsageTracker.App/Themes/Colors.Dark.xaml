<!--
    Dark palette, modeled on Obsidian's default dark theme (base-00 … base-100, accent
    hsl(258, 88%, 66%)). Exactly one Colors.*.xaml is merged into Application.Resources at a
    time; ThemeManager swaps it at runtime, so every palette brush must be referenced via
    DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Surfaces: page = background-primary, sidebar = background-secondary,
         setting group = background-primary-alt. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF282828" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF232323" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FF282828" />
    <!-- Menus and drop-down lists (menu-background = background-secondary) and their shadow strength. -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF282828" />
    <sys:Double x:Key="MenuShadowOpacity">0.35</sys:Double>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3F3F3F" />

    <!-- Accent: Obsidian dark uses color-accent for interactive-accent and -1 for its hover. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8A5CF5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA68AF9" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF7A48F0" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFA88BFA" />

    <!-- Text: text-normal / text-muted / text-faint (slightly lifted for readability). -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFDADADA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB3B3B3" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF858585" />

    <!-- Interactive surfaces: buttons and drop-downs (interactive-normal / -hover). -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#11FFFFFF" />

    <!-- Status: text shades and usage-bar colors (Obsidian's dark color-green / -orange / -red). -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFB464C" />
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#26FB464C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF44CF6E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE9973F" />
    <SolidColorBrush x:Key="UsageSafeBrush" Color="#FF44CF6E" />
    <SolidColorBrush x:Key="UsageModerateBrush" Color="#FFE9973F" />
    <SolidColorBrush x:Key="UsageCriticalBrush" Color="#FFFB464C" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FF333333" />

    <!-- History chart series (session, weekly): a pair checked for color-vision-deficiency
         separation against this palette's surface, and kept clear of the status colors above. -->
    <SolidColorBrush x:Key="ChartSeries1Brush" Color="#FF3987E5" />
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="#FFD55181" />

</ResourceDictionary>
