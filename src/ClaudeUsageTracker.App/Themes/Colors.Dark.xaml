<!--
    Dark palette. Exactly one Colors.*.xaml is merged into Application.Resources at a time;
    ThemeManager swaps it at runtime, so every palette brush must be referenced via DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3A96DD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF57A6E3" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF2C7CB8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF34C759" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC107" />

</ResourceDictionary>
