<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:ClaudeUsageTracker.App.Views">

    <!-- Palette brushes live in Colors.Dark.xaml / Colors.Light.xaml (see ThemeManager). -->

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="UIFontFamily">Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Meiryo UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="FlyoutShadowEffect" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black" />

    <!-- ===== Type ramp (Windows 11 / Fluent) =====
         Windows set FontSize="{StaticResource BodyFontSize}" so controls inherit Body;
         TextBlocks pick one of the three styles below instead of hard-coding a size.
         The implicit TextBlock style deliberately sets no FontSize, so icon glyphs
         inside buttons keep inheriting the button's size. -->
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>

    <!-- ===== TextBlock ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
    </Style>

    <!-- Secondary info: reset times, timestamps, hints, messages. -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    </Style>

    <!-- Titles, section headings, key values.
         Laid out in Ideal mode, unlike the Display mode the windows set: snapped to whole pixels,
         a semibold stroke is either one pixel wide or two, so Japanese text comes out much
         heavier than the Latin text and digits beside it, which barely thicken at all. -->
    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ===== ToolTip (Obsidian .tooltip) =====
         Near-black bubble (background-modifier-message) with light text, 4px corners, centered
         text up to 300px wide, and Obsidian's "pop-down" entrance: over 200ms it fades in while
         swelling to 105% and settling back to 100%. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TooltipBackgroundBrush}" />
        <Setter Property="Foreground" Value="#FFFAFAFA" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- The margin leaves room for the shadow inside the transparent popup. -->
                    <Border x:Name="Bubble" Margin="6,2,6,10" MaxWidth="300" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.15" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ToolTip.Opened">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bubble" Storyboard.TargetProperty="Opacity">
                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.7" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleX">
                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="1.02" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="1.05" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BubbleScale" Storyboard.TargetProperty="ScaleY">
                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="1.02" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="1.05" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons (Obsidian style) =====
         Flat "interactive-normal" surface with a hairline border and a soft 1px drop shadow;
         hover lightens the surface rather than coloring the border. The shadow sits on its own
         layer behind the content so the label text isn't rendered through the effect. -->
    <DropShadowEffect x:Key="ControlShadowEffect" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.12" Color="Black" />

    <Style x:Key="ButtonBaseStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Effect="{StaticResource ControlShadowEffect}" />
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}" />

    <!-- "mod-cta": solid accent button for the primary action. -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Effect="{StaticResource ControlShadowEffect}" />
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Transparent icon buttons ("clickable-icon" in Obsidian): a rounded square that only
         shows a background on hover. -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Spins the refresh glyph while a refresh is in flight (button is disabled during refresh) -->
    <Style x:Key="RefreshIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SpinStoryboard">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360"
                                              Duration="0:0:0.8" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource SubtleBorderBrush}" Background="Transparent" VerticalAlignment="Center">
                            <!-- Geometry is offset by half the stroke width so its natural size
                                 (measured from 0,0) equals its drawn extent, letting it center. -->
                            <Path x:Name="CheckMark" Data="M0.8,4.1 L3.5,6.8 L8.8,0.8" Stroke="White" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Obsidian toggle, reproduced from its app.css (.modal .checkbox-container):
         - track 40 x 22, pill, background-modifier-border-hover when off and interactive-accent
           when on; the color switches instantly (Obsidian doesn't transition it), with a soft
           inset shadow along the top edge.
         - 18 x 18 white knob inset 2px, shadow 0 1px 2px; it slides 2 -> 20 over 0.15s ease-in-out.
         - while pressed the knob swells to 26 x 26 (overflowing the track by 2px), after a 0.05s
           delay over 0.1s; when the toggle is on it also shifts 4px left so it swells inward.
         - no hover effect; disabled = 50% opacity.
         A CheckBox whose content sits on the left and the switch on the right, so the whole row
         (label + description) is the click target. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- The knob's slide between off and on is played from code (Views/ToggleSwitch.cs): as
             the IsChecked trigger's enter/exit actions it also ran when the template was first
             applied, so every "on" toggle slid in from "off" when its page was first shown. -->
        <Setter Property="views:ToggleSwitch.AnimateKnob" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <ControlTemplate.Resources>
                        <SineEase x:Key="EaseInOut" EasingMode="EaseInOut" />
                        <!-- Press: grow after 0.05s over 0.1s (CSS: 0.1s ease-in-out 0.05s). -->
                        <Storyboard x:Key="PressIn">
                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Width" To="26"
                                             BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Height" To="26"
                                             BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Canvas.Top)" To="-2"
                                             BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                        </Storyboard>
                        <Storyboard x:Key="PressOut">
                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Width" To="18"
                                             BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Height" To="18"
                                             BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Canvas.Top)" To="2"
                                             BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource ToggleOffBrush}" />
                            <!-- inset 0 4px 10px rgba(0,0,0,.07) -->
                            <Border CornerRadius="11" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#16000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.7" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- A Canvas lets the pressed knob overflow the track without being clipped. -->
                            <Canvas>
                                <!-- Canvas.Left: translate3d(2px) off / (40 - 18 - 2 = 20px) on -->
                                <Border x:Name="Knob" Width="18" Height="18" Canvas.Left="2" Canvas.Top="2" CornerRadius="13" Background="White">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.15" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <!-- "left: -4px" while an enabled toggle is pressed -->
                                        <TranslateTransform x:Name="KnobPressShift" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Canvas.Left" Value="20" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobPressShift" Storyboard.TargetProperty="X" To="-4"
                                                         BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobPressShift" Storyboard.TargetProperty="X" To="0"
                                                         BeginTime="0:0:0.05" Duration="0:0:0.1" EasingFunction="{StaticResource EaseInOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider =====
         Horizontal only. A 4px pill track, accent-filled up to a 16px white
         knob (the toggle's knob); clicking the track jumps there (set IsMoveToPointEnabled on the Slider). -->
    <Style x:Key="SliderTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <!-- Transparent fill so the full height is clickable, not just the 4px line. -->
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderStyle" TargetType="Slider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource ToggleOffBrush}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackButtonStyle}"
                                              Background="{DynamicResource AccentBrush}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButtonStyle}"
                                              Background="Transparent" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.25" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox =====
         The box follows Obsidian's .dropdown (30px tall, 5px corners, interactive-normal with a
         hairline ring and soft shadow, 13px text, lucide "chevrons-up-down" drawn as vectors so
         it stays crisp). The list follows Obsidian's .menu: background-secondary panel, 1px
         border-hover outline, 8px corners, 6px padding, the large soft "shadow-s", and 4px-radius
         items that highlight with background-modifier-hover; the chosen item carries a check.
         It opens with a short fade and 4px drop (Obsidian's own menus just appear). -->
    <Geometry x:Key="ChevronsUpDownGeometry">M7,15 L12,20 L17,15 M7,9 L12,4 L17,9</Geometry>
    <Geometry x:Key="CheckGeometry">M20,6 L9,17 L4,12</Geometry>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" MinHeight="28" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Path x:Name="Check" Grid.Column="1" Data="{StaticResource CheckGeometry}" Stretch="Uniform"
                                  Width="12" Height="12" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="5"
                                                Effect="{StaticResource ControlShadowEffect}" />
                                        <Border x:Name="Bd" Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5">
                                            <Path Data="{StaticResource ChevronsUpDownGeometry}" Stretch="Uniform"
                                                  Width="8" Height="12" Margin="0,0,11,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <!-- The margin leaves the shadow room inside the transparent popup; the offsets
                             line the panel's edge up with the box and leave a 4px gap below it. -->
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               HorizontalOffset="-16" VerticalOffset="-2" AllowsTransparency="True" Focusable="False">
                            <Border x:Name="Panel" Margin="16,6,16,32"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="6" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270"
                                                      Opacity="{DynamicResource MenuShadowOpacity}" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PanelOffset" Y="-4" />
                                </Border.RenderTransform>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PanelOffset" Storyboard.TargetProperty="Y"
                                                         From="-4" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="PanelOffset" Storyboard.TargetProperty="Y"
                                                         To="-4" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar: slim rounded thumb, no arrow buttons (Windows 11 / Obsidian style) ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Bd" Width="4" CornerRadius="2" Margin="0,4"
                                                Background="{DynamicResource TextTertiaryBrush}" Opacity="0.6" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Width" Value="6" />
                                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- TextBox.Padding is applied internally by the TextBox's own text renderer
                         (it insets text within PART_ContentHost), so it must not be re-applied
                         here too via Margin/Padding on the Border or ScrollViewer — doing so
                         double-applies it and squashes the visible text area to almost nothing. -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Rounded "pill" progress bar ===== -->
    <Style x:Key="PillProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}">
                        <Grid>
                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A usage bar: the pill, in the color of its row's status. For a ProgressBar whose
         DataContext is a UsageRowViewModel. Colors come from the palette (Obsidian's green /
         orange / red), so they follow the theme live. -->
    <Style x:Key="UsageProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource PillProgressBarStyle}">
        <Setter Property="Foreground" Value="{DynamicResource UsageSafeBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Moderate">
                <Setter Property="Foreground" Value="{DynamicResource UsageModerateBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Critical">
                <Setter Property="Foreground" Value="{DynamicResource UsageCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One usage row in full on a single line ("Session (5h)  80% · Resets in 1h 58m"): what the
         compact views' tooltips list, since they themselves show less. -->
    <DataTemplate x:Key="UsageRowSummaryTemplate">
        <TextBlock>
            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding PercentageText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ResetText, Mode=OneWay}" />
        </TextBlock>
    </DataTemplate>

    <!-- ===== Context menu (tray icon), Obsidian menu style =====
         Rounded 8px panel with a soft shadow; the outer margin leaves the shadow room inside
         the (transparent) popup so it isn't clipped. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="16,6,16,32" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="{DynamicResource MenuShadowOpacity}" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu item: icon column (a Segoe Fluent glyph set as MenuItem.Icon) + label.
         Hover/keyboard highlight is a subtle overlay, as in Windows 11 menus, not the accent color.
         The glyph's font is set where the icon is created (see TrayIconController). -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Height="28" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus look separators up by this key rather than the implicit Separator style. Full width, as in Windows 11. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="-6,6" Background="{DynamicResource BorderBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
