<!--
    Light palette. Exactly one Colors.*.xaml is merged into Application.Resources at a time;
    ThemeManager swaps it at runtime, so every palette brush must be referenced via DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Text colors are opaque, not black-with-alpha: semi-transparent text renders washed out
         on light backgrounds. Tertiary (#6B6B6B) still meets WCAG AA (~4.9:1) on #F3F3F3. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#33000000" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1975C5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF005A9E" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF4D4D4D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6B6B6B" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#14000000" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9D5D00" />

</ResourceDictionary>
