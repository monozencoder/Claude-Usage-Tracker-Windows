<!--
    Light palette, modeled on Obsidian's default light theme (base-00 … base-100), with
    Claude's orange as the accent. Exactly one Colors.*.xaml is merged into Application.Resources at a
    time; ThemeManager swaps it at runtime, so every palette brush must be referenced via
    DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Surfaces: page = background-primary, sidebar = background-secondary,
         setting group = background-primary-alt. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFF6F6F6" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFAFAFA" />
    <!-- Popups (menus, drop-downs, tooltips) sit on the page, so they use the page color. -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFFFF" />
    <!-- Menus and drop-down lists (menu-background = background-secondary) and their shadow strength. -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFF6F6F6" />
    <sys:Double x:Key="MenuShadowOpacity">0.16</sys:Double>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E4E4" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FFDADADA" />

    <!-- Accent: Claude's brand orange in place of Obsidian's purple, with a lighter hover and a
         darker pressed shade. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD97757" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFE28D70" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FFC6613F" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />
    <!-- Links and accent-colored text need a darker shade to stay readable on white. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFB5502C" />

    <!-- Text: text-normal / text-muted / a slightly darker text-faint (Obsidian's #ABABAB is too
         pale for reset times and timestamps). -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF222222" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF7E7E7E" />

    <!-- Interactive surfaces: buttons and drop-downs (interactive-normal / -hover). -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#2B000000" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#FFDADADA" />    <SolidColorBrush x:Key="FocusRingBrush" Color="#FFBDBDBD" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#11000000" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1C000000" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#11000000" />

    <!-- Status: text shades (readable on white) and the brighter usage-bar colors
         (Obsidian's color-green / color-orange / color-red). -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD7263D" />
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#1AE93147" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF0A8A3E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC25F00" />
    <SolidColorBrush x:Key="UsageSafeBrush" Color="#FF08B94E" />
    <SolidColorBrush x:Key="UsageModerateBrush" Color="#FFEC7500" />
    <SolidColorBrush x:Key="UsageCriticalBrush" Color="#FFE93147" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FFEFEFEF" />

</ResourceDictionary>
