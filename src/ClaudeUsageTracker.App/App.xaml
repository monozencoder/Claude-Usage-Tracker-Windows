<Application x:Class="ClaudeUsageTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClaudeUsageTracker.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Must stay first: ThemeManager replaces MergedDictionaries[0] to switch palettes. -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BooleanInverter x:Key="BooleanInverter" />
            <converters:EnumEqualsConverter x:Key="EnumEquals" />
            <converters:UsageStatusToBrushConverter x:Key="StatusToBrush" />
            <converters:ChoiceLabelConverter x:Key="ChoiceLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
